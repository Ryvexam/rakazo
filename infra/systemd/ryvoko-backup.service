[Unit]
Description=Create and verify a Ryvoko production backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/ryvoko/backup.env
ExecStart=/usr/local/sbin/ryvoko-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups
